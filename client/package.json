{
  "name": "openagile",
  "version": "3.1.2",
  "type": "module",
  "description": "A local-first personal + AI Agent kanban board for task project people anything management.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "release:prepare": "node scripts/prepare-release.mjs",
    "test": "npm run test:unit && npm run test:dom",
    "test:unit": "vitest run --config vitest.config.js",
    "test:dom": "vitest run --config vitest.dom.config.js",
    "test:overview": "node scripts/generate-test-overview.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide": "^0.469.0",
    "sortablejs": "^1.15.6"
  }
}
